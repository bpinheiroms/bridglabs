{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridglabs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bridglabs.com", "custom_domain": true },
    { "pattern": "www.bridglabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
