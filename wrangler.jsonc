{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridglabs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bridglabs.com", "custom_domain": true },
    { "pattern": "www.bridglabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Product numbers for the page, refreshed from PostHog once a day (06:00 in São Paulo).
  "kv_namespaces": [{ "binding": "STATS", "id": "fc95f4dfbb5a46d3b53a6aa10ff4924c" }],
  "triggers": { "crons": ["0 9 * * *"] },
  "observability": {
    "enabled": true
  }
}
