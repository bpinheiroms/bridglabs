{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridglabs",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bridglabs.com", "custom_domain": true },
    { "pattern": "www.bridglabs.com", "custom_domain": true }
  ],
  // Static files only, with no Worker script: Cloudflare serves every request
  // straight from the assets, which it does not bill. Headers live in
  // public/_headers and the apex → www redirect is a Redirect Rule on the zone.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Clears the cron this Worker used to run; it now lives in stats/wrangler.jsonc.
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true
  }
}
