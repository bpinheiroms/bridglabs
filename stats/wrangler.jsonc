{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Reads the product numbers from PostHog once a day and publishes them as
  // stats.json in R2, served from stats.bridglabs.com behind the edge cache.
  // It has no routes, so no visitor can ever invoke it.
  "name": "bridglabs-stats",
  "main": "../src/statsCron.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 9 * * *"] },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "bridglabs-stats" }],
  "observability": {
    "enabled": true
  }
}
